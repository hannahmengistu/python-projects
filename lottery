import random

def pick_numbers():
    for x in range(5):
        yield random.randint(1,69)

while True:
    correct_guesses = 0
    user_guesses = []

    print("What would you like to do? ")
    print("1) Pay PowerBall (you will select five numbers from 1 to 69)")
    print("2) Exit")
  
    user_input = input("Please select 1 or 2: ")

    if user_input == '1':
        for i in range(5):
            guess = int(input("Please select a number from 1 - 69: "))
            user_guesses.append(guess)

        for x in pick_numbers():
            print(f"The winning number is {x}")
            if x in user_guesses:
                print(f"There is a match with number {x}")
                correct_guesses += 1
        print(f"You have {correct_guesses} correct guesses")

    else:
        break
